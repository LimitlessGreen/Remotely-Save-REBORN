{
  "name": "remotely-save",
  "version": "0.5.25",
  "description": "This is yet another sync plugin for Obsidian app.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "deploy:dev": "node devDeploy.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "format": "npx @biomejs/biome check --write .",
    "clean": "npx rimraf main.js",
    "test": "mocha --import=tsx --require tests/obsidianShim.ts \"tests/**/*.ts\"",
    "test:deep": "mocha --import=tsx --require tests/obsidianShim.ts \"tests/integration/*.deep.test.ts\"",
    "test:libs": "npm test --workspaces --if-present",
    "prepare": "husky"
  },
  "browser": {
    "path": "path-browserify",
    "process": "process/browser",
    "stream": "stream-browserify",
    "crypto": "crypto-browserify",
    "url": "url/",
    "fs": false,
    "vm": false
  },
  "source": "main.ts",
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "workspaces": [
    "libs/*"
  ],
  "lint-staged": {
    "*.{js,ts,mjs,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/sinon": "^22.0.0",
    "builtin-modules": "^5.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-inline-worker": "^0.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "mocha": "^11.8.0",
    "npm-check-updates": "^23.0.2",
    "obsidian": "^1.13.1",
    "sinon": "^22.1.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "webdav-server": "^2.6.3",
    "yargs": "^18.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/lib-storage": "^3.1110.0",
    "@aws-sdk/signature-v4-crt": "^3.1110.0",
    "@aws-sdk/types": "^3.974.3",
    "@azure/msal-node": "^5.5.0",
    "@azure/storage-blob": "^12.33.0",
    "@fyears/eme": "file:libs/eme",
    "@fyears/rclone-crypt": "file:libs/rclone-crypt",
    "@fyears/tsqueue": "file:libs/tsqueue",
    "@internxt/inxt-js": "^3.3.5",
    "@internxt/lib": "^1.5.2",
    "@internxt/sdk": "^1.20.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@sanity/diff-match-patch": "^3.2.0",
    "@smithy/fetch-http-handler": "^5.7.0",
    "@smithy/protocol-http": "^5.6.0",
    "@smithy/querystring-builder": "^4.5.0",
    "acorn": "^8.18.0",
    "assert": "^2.1.0",
    "aws-crt": "^1.33.1",
    "bottleneck": "^2.19.5",
    "box-typescript-sdk-gen": "^1.19.1",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "console-browserify": "^1.2.0",
    "crypto-browserify": "^3.12.1",
    "dropbox": "^10.45.0",
    "emoji-regex": "^10.6.0",
    "events": "^3.3.0",
    "fast-xml-parser": "^5.10.1",
    "http-status-codes": "^2.3.0",
    "https-browserify": "^1.0.0",
    "js-base64": "^3.9.2",
    "localforage": "^1.10.0",
    "localforage-getitems": "^1.4.2",
    "localforage-removeitems": "^1.4.0",
    "lucide": "^1.31.0",
    "mime-types": "^3.0.2",
    "mustache": "^4.2.0",
    "nanoid": "^6.0.1",
    "node-diff3": "^3.2.1",
    "os-browserify": "^0.3.0",
    "p-queue": "^9.3.3",
    "path-browserify": "^1.0.1",
    "pcloud-sdk-js": "^2.0.0",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "querystring-es3": "^0.2.1",
    "rfc4648": "^1.5.4",
    "rimraf": "^6.1.3",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "timers-browserify": "^2.0.12",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "webdav": "^5.10.0",
    "xregexp": "^5.1.2"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.0",
    "uuid": "^11.1.1"
  }
}
